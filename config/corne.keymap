#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        virgula: virgula {
            compatible = "zmk,behavior-tap-dance";
            label = "VIRGULA";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp DOT>;

            tapping-term-ms = <250>;
        };

        interrogacao: interrogacao {
            compatible = "zmk,behavior-tap-dance";
            label = "INTERROGACAO";
            #binding-cells = <0>;
            bindings = <&kp QUESTION>, <&kp EXCLAMATION>;

            tapping-term-ms = <250>;
        };

        soma: soma {
            compatible = "zmk,behavior-tap-dance";
            label = "SOMA";
            #binding-cells = <0>;
            bindings = <&kp PLUS>, <&kp MINUS>;

            tapping-term-ms = <250>;
        };

        multiplicacao: multiplicacao {
            compatible = "zmk,behavior-tap-dance";
            label = "MULTIPLICACAO";
            #binding-cells = <0>;
            bindings = <&kp ASTERISK>, <&kp SLASH>;

            tapping-term-ms = <250>;
        };

        agudo: agudo {
            compatible = "zmk,behavior-tap-dance";
            label = "AGUDO";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp GRAVE>;

            tapping-term-ms = <250>;
        };

        acentotil: acentotil {
            compatible = "zmk,behavior-tap-dance";
            label = "ACENTOTIL";
            #binding-cells = <0>;
            bindings = <&kp TILDE>, <&kp CARET>;

            tapping-term-ms = <250>;
        };

        parenteses: parenteses {
            compatible = "zmk,behavior-tap-dance";
            label = "PARENTESES";
            #binding-cells = <0>;
            bindings = <&kp LPAR>, <&kp RPAR>;

            tapping-term-ms = <250>;
        };

        achave: achave {
            compatible = "zmk,behavior-tap-dance";
            label = "ACHAVE";
            #binding-cells = <0>;
            bindings = <&kp LBRC>, <&kp RBRC>;

            tapping-term-ms = <250>;
        };

        acolchete: acolchete {
            compatible = "zmk,behavior-tap-dance";
            label = "ACOLCHETE";
            #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp RBKT>;

            tapping-term-ms = <250>;
        };

        amenor: amenor {
            compatible = "zmk,behavior-tap-dance";
            label = "AMENOR";
            #binding-cells = <0>;
            bindings = <&kp LT>, <&kp GT>;

            tapping-term-ms = <250>;
        };

        lay1: lay1 {
            compatible = "zmk,behavior-tap-dance";
            label = "LAY1";
            #binding-cells = <0>;
            bindings = <&to 3>, <&to 0>;

            tapping-term-ms = <250>;
        };

        lay2: lay2 {
            compatible = "zmk,behavior-tap-dance";
            label = "LAY2";
            #binding-cells = <0>;
            bindings = <&to 1>, <&to 3>;

            tapping-term-ms = <250>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* ---------------------------------------------------------
         * CAMADA 0: BASE (QWERTY)
         * --------------------------------------------------------- */

        default_layer {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E         &kp R  &kp T        &kp Y    &kp U  &kp I         &kp O          &kp P     &kp BSPC
&kp TAB    &kp A  &kp S  &kp D         &kp F  &kp G        &kp H    &kp J  &kp K         &kp L          &kp SEMI  &kp DEL
&kp LSHFT  &kp Z  &kp X  &kp C         &kp V  &kp B        &kp N    &kp M  &virgula      &interrogacao  &kp FSLH  &kp ESC
                         &kp LEFT_ALT  &lay1  &kp SPACE    &kp RET  &lay2  &kp LEFT_GUI
            >;
        };

        /* ---------------------------------------------------------
         * CAMADA 1: LOWER (NÚMEROS & NAVEGAÇÃO)
         * --------------------------------------------------------- */

        symbolpad {
            bindings = <
&kp F1      &kp F2        &kp F3        &kp F4        &kp F5        &kp F6          &kp F7    &kp F8    &kp F9    &kp F10    &kp F11  &kp F12
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &none    &none
&kp LSHFT   &none         &none         &none         &none         &none           &none     &none     &none     &none      &none    &none
                                        &kp LGUI      &lay1         &kp SPACE       &kp RET   &lay2     &kp RALT
            >;
        };

        /* ---------------------------------------------------------
         * CAMADA 2: RAISE (SÍMBOLOS & PONTUAÇÃO)
         * --------------------------------------------------------- */

        numberpad {
            bindings = <
&kp TAB         &kp LC(LS(C))  &kp AT         &kp HASH        &kp DLLR     &kp F2        &multiplicacao  &kp N7        &kp N8        &kp N9        &parenteses  &kp BSPC
&kp LEFT_SHIFT  &kp LC(LS(V))  &kp RA(SEMI)   &kp AMPERSAND   &kp PERCENT  &kp ESCAPE    &soma           &kp NUMBER_4  &kp N5        &kp NUMBER_6  &acolchete   &virgula
&kp LCTRL       &achave        &interrogacao  &kp UNDERSCORE  &kp CARET    &kp EQUAL     &kp N0          &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERCENT  &kp EQUAL
                                              &kp LEFT_ALT    &lay1        &kp SPACE     &kp RET         &lay2         &kp LEFT_GUI
            >;
        };

        /* ---------------------------------------------------------
         * CAMADA 3: ADJUST (SISTEMA & BOOTLOADER)
         * --------------------------------------------------------- */

        mousepad {
            bindings = <
&msc SCRL_UP    &mkp LCLK        &mmv MOVE_UP    &mkp RCLK        &mkp MB4  &mkp MB3    &none  &none     &kp UP_ARROW  &none      &multiplicacao  &kp BACKSPACE
&msc SCRL_DOWN  &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MB5  &none       &none  &kp LEFT  &kp DOWN      &kp RIGHT  &none           &kp LEFT_SHIFT
&msc SCRL_LEFT  &msc SCRL_RIGHT  &none           &msc SCRL_RIGHT  &none     &none       &none  &none     &none         &none      &none           &kp LCTRL
                                                 &none            &lay1     &none       &none  &lay2     &kp LEFT_ALT
            >;
        };
    };
};
