#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        virgula: virgula {
            compatible = "zmk,behavior-tap-dance";
            label = "VIRGULA";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp DOT>, <&kp SEMI>, <&kp DOUBLE_QUOTES>;

            tapping-term-ms = <250>;
        };

        interrogacao: interrogacao {
            compatible = "zmk,behavior-tap-dance";
            label = "INTERROGACAO";
            #binding-cells = <0>;
            bindings = <&kp QUESTION>, <&kp EXCLAMATION>;

            tapping-term-ms = <250>;
        };

        soma: soma {
            compatible = "zmk,behavior-tap-dance";
            label = "SOMA";
            #binding-cells = <0>;
            bindings = <&kp PLUS>, <&kp MINUS>, <&kp SLASH>, <&kp ASTERISK>;

            tapping-term-ms = <250>;
        };

        multiplicacao: multiplicacao {
            compatible = "zmk,behavior-tap-dance";
            label = "MULTIPLICACAO";
            #binding-cells = <0>;
            bindings = <&kp ASTERISK>, <&kp SLASH>;

            tapping-term-ms = <250>;
        };

        agudo: agudo {
            compatible = "zmk,behavior-tap-dance";
            label = "AGUDO";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp GRAVE>, <&kp CARET>, <&kp TILDE>;

            tapping-term-ms = <250>;
        };

        acentotil: acentotil {
            compatible = "zmk,behavior-tap-dance";
            label = "ACENTOTIL";
            #binding-cells = <0>;
            bindings = <&kp TILDE>, <&kp CARET>;

            tapping-term-ms = <250>;
        };

        parenteses: parenteses {
            compatible = "zmk,behavior-tap-dance";
            label = "PARENTESES";
            #binding-cells = <0>;
            bindings =
                <&kp LPAR>,
                <&kp RPAR>,
                <&kp LEFT_BRACKET>,
                <&kp RIGHT_BRACKET>;

            tapping-term-ms = <250>;
        };

        achave: achave {
            compatible = "zmk,behavior-tap-dance";
            label = "ACHAVE";
            #binding-cells = <0>;
            bindings = <&kp LBRC>, <&kp RBRC>;

            tapping-term-ms = <250>;
        };

        acolchete: acolchete {
            compatible = "zmk,behavior-tap-dance";
            label = "ACOLCHETE";
            #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp RBKT>;

            tapping-term-ms = <250>;
        };

        amenor: amenor {
            compatible = "zmk,behavior-tap-dance";
            label = "AMENOR";
            #binding-cells = <0>;
            bindings = <&kp LT>, <&kp GT>, <&kp LBRC>, <&kp RBRC>;

            tapping-term-ms = <250>;
        };

        lay1: lay1 {
            compatible = "zmk,behavior-tap-dance";
            label = "LAY1";
            #binding-cells = <0>;
            bindings = <&to 0>, <&to 1>, <&none>, <&none>, <&to 4>;

            tapping-term-ms = <250>;
        };

        lay2: lay2 {
            compatible = "zmk,behavior-tap-dance";
            label = "LAY2";
            #binding-cells = <0>;
            bindings = <&to 2>, <&to 3>, <&none>, <&none>, <&to 4>;

            tapping-term-ms = <250>;
        };

        teclaaa: teclaaa {
            compatible = "zmk,behavior-tap-dance";
            label = "TECLAAA";
            #binding-cells = <0>;
            bindings =
                <&kp A>,
                <&tecla_aagudo>,
                <&tecla_aatil>,
                <&tecla_acrase>;

            tapping-term-ms = <250>;
        };

        teclae: teclae {
            compatible = "zmk,behavior-tap-dance";
            label = "TECLAE";
            #binding-cells = <0>;
            bindings = <&kp E>, <&tecla_eagudo>, <&tecla_ecircunflexo>;

            tapping-term-ms = <250>;
        };

        teclao: teclao {
            compatible = "zmk,behavior-tap-dance";
            label = "TECLAO";
            #binding-cells = <0>;
            bindings =
                <&kp O>,
                <&tecla_oagudo>,
                <&tecla_otil>,
                <&tecla_ocircunflexo>;

            tapping-term-ms = <250>;
        };

        teclai: teclai {
            compatible = "zmk,behavior-tap-dance";
            label = "TECLAI";
            #binding-cells = <0>;
            bindings = <&kp I>, <&tecla_iagudo>;

            tapping-term-ms = <250>;
        };

        teclau: teclau {
            compatible = "zmk,behavior-tap-dance";
            label = "TECLAU";
            #binding-cells = <0>;
            bindings = <&kp U>, <&tecla_uagudo>;

            tapping-term-ms = <250>;
        };

        teclac: teclac {
            compatible = "zmk,behavior-tap-dance";
            label = "TECLAC";
            #binding-cells = <0>;
            bindings = <&kp C>, <&teclaa_cedilha>;

            tapping-term-ms = <250>;
        };

        teclan: teclan {
            compatible = "zmk,behavior-tap-dance";
            label = "TECLAN";
            #binding-cells = <0>;
            bindings = <&kp N>, <&tecla_ntil>;

            tapping-term-ms = <250>;
        };

        blue1: blue1 {
            compatible = "zmk,behavior-tap-dance";
            label = "BLUE1";
            #binding-cells = <0>;
            bindings =
                <&bt BT_SEL 0>,
                <&bt BT_SEL 1>,
                <&bt BT_SEL 2>,
                <&bt BT_SEL 4>;

            tapping-term-ms = <250>;
        };

        blue2: blue2 {
            compatible = "zmk,behavior-tap-dance";
            label = "BLUE2";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&bt BT_SEL 3>;

            tapping-term-ms = <250>;
        };

        teclaarroba: teclaarroba {
            compatible = "zmk,behavior-tap-dance";
            label = "TECLAARROBA";
            #binding-cells = <0>;
            bindings = <&kp AT_SIGN>, <&kp UNDERSCORE>, <&kp BSLH>, <&kp PIPE>;

            tapping-term-ms = <250>;
        };

        teclabarra: teclabarra {
            compatible = "zmk,behavior-tap-dance";
            label = "TECLABARRA";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&kp BSLH>, <&kp PIPE>;

            tapping-term-ms = <250>;
        };

        pontovirgula: pontovirgula {
            compatible = "zmk,behavior-tap-dance";
            label = "PONTOVIRGULA";
            #binding-cells = <0>;
            bindings = <&kp SEMI>, <&kp SQT>;

            tapping-term-ms = <250>;
        };

        tabesc: tabesc {
            compatible = "zmk,behavior-tap-dance";
            label = "TABESC";
            #binding-cells = <0>;
            bindings = <&kp TAB>, <&kp ESC>;

            tapping-term-ms = <220>;
        };

        bkdel: bkdel {
            compatible = "zmk,behavior-tap-dance";
            label = "BKDEL";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DEL>;

            tapping-term-ms = <210>;
        };
    };

    macros {
        tecla_eagudo: eagudo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp E>;
            label = "EAGUDO";
        };

        tecla_ecircunflexo: ecircunflexo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CARET &kp E>;
            label = "ECIRCUNFLEXO";
        };

        tecla_ntil: tecla_ntil {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TILDE &kp N>;
            label = "TECLA_NTIL";
        };

        tecla_aagudo: tecla_aagudo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp A>;
            label = "TECLA_AAGUDO";
        };

        tecla_acircunflexo: tecla_acircunflexo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CARET &kp A>;
            label = "TECLA_ACIRCUNFLEXO";
        };

        tecla_aatil: tecla_atil {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TILDE &kp A>;
            label = "TECLA_ATIL";
        };

        tecla_acrase: tecla_acrase {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp A>;
            label = "TECLA_ACRASE";
        };

        tecla_iagudo: tecla_iagudo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp I>;
            label = "TECLA_IAGUDO";
        };

        tecla_oagudo: tecla_oagudo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp O>;
            label = "TECLA_OAGUDO";
        };

        tecla_uagudo: tecla_uagudo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp U>;
            label = "TECLA_UAGUDO";
        };

        tecla_ocircunflexo: tecla_ocircunflexo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CARET &kp O>;
            label = "TECLA_OCIRCUNFLEXO";
        };

        tecla_otil: tecla_otil {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TILDE &kp O>;
            label = "TECLA_OTIL";
        };

        teclaa_cedilha: teclaa_cedilha {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp C>;
            label = "TECLAA_CEDILHA";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* ---------------------------------------------------------
         * CAMADA 0: BASE (QWERTY)
         * --------------------------------------------------------- */

        default_layer {
            bindings = <
&kp ESC    &kp Q     &kp W  &teclae    &kp R  &kp T        &kp Y    &teclau  &teclai    &teclao        &kp P          &kp BSPC
&kp TAB    &teclaaa  &kp S  &kp D      &kp F  &kp G        &kp H    &kp J    &kp K      &kp L          &pontovirgula  &parenteses
&kp LSHFT  &kp Z     &kp X  &teclac    &kp V  &kp B        &teclan  &kp M    &virgula   &interrogacao  &teclabarra    &teclaarroba
                            &kp LCTRL  &lay1  &kp SPACE    &kp RET  &lay2    &kp LCTRL
            >;
        };

        /* ---------------------------------------------------------
         * CAMADA 1: LOWER (NÚMEROS & NAVEGAÇÃO)
         * --------------------------------------------------------- */

        symbolpad {
            bindings = <
&kp F1           &kp F2        &kp F3             &kp F4      &kp F5       &kp F6       &kp F7   &kp F8      &kp F9    &kp F10        &kp F11  &kp F12
&kp EXCLAMATION  &kp AT_SIGN   &kp HASH           &kp DOLLAR  &kp PERCENT  &kp CARET    &amenor  &acolchete  &kp HOME  &kp PAGE_UP    &none    &blue1
&kp AMPERSAND    &kp ASTERISK  &kp RA(SEMICOLON)  &none       &none        &none        &achave  &kp DEL     &kp END   &kp PAGE_DOWN  &none    &blue2
                                                  &kp LGUI    &lay1        &kp SPACE    &kp RET  &lay2       &kp RALT
            >;
        };

        /* ---------------------------------------------------------
         * CAMADA 2: RAISE (SÍMBOLOS & PONTUAÇÃO)
         * --------------------------------------------------------- */

        numberpad {
            bindings = <
&kp TAB         &kp LC(LS(C))  &kp AT         &kp HASH        &kp DLLR     &kp F2        &multiplicacao  &kp N7        &kp N8        &kp N9        &parenteses  &kp BSPC
&kp LEFT_SHIFT  &kp LC(LS(V))  &kp RA(SEMI)   &kp AMPERSAND   &kp PERCENT  &kp ESCAPE    &soma           &kp NUMBER_4  &kp N5        &kp NUMBER_6  &acolchete   &virgula
&kp LCTRL       &achave        &interrogacao  &kp UNDERSCORE  &kp CARET    &kp EQUAL     &kp N0          &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERCENT  &kp EQUAL
                                              &kp LEFT_ALT    &lay1        &kp SPACE     &kp RET         &lay2         &kp LEFT_GUI
            >;
        };

        /* ---------------------------------------------------------
         * CAMADA 3: ADJUST (SISTEMA & BOOTLOADER)
         * --------------------------------------------------------- */

        mousepad {
            bindings = <
&msc SCRL_UP    &mkp LCLK        &mmv MOVE_UP    &mkp RCLK        &mkp MB4  &mkp MB3    &none  &none     &kp UP_ARROW  &none      &multiplicacao  &kp BACKSPACE
&msc SCRL_DOWN  &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MB5  &none       &none  &kp LEFT  &kp DOWN      &kp RIGHT  &none           &kp LEFT_SHIFT
&msc SCRL_LEFT  &msc SCRL_RIGHT  &none           &msc SCRL_RIGHT  &none     &none       &none  &none     &none         &none      &none           &kp LCTRL
                                                 &none            &lay1     &none       &none  &lay2     &kp LEFT_ALT
            >;
        };

        config {
            bindings = <
&bt BT_CLR      &none   &trans  &trans  &trans  &bootloader     &bt BT_CLR      &trans  &trans  &none   &none   &bootloader
&bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &sys_reset      &bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &sys_reset
&trans          &trans  &trans  &trans  &trans  &out OUT_TOG    &trans          &trans  &trans  &none   &none   &out OUT_TOG
                                &trans  &lay1   &trans          &trans          &lay2   &trans
            >;
        };
    };
};
