#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        /* TD(0): Pontuação (. , ? !) */
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp KP_DOT>, <&kp KP_COMMA>, <&kp QMARK>, <&kp EXCL>;
        };

        /* TD(1): Operadores Matemáticos (+ - * /) */
        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp KP_PLUS>, <&kp KP_MINUS>, <&kp KP_MULTIPLY>, <&kp KP_SLASH>;
        };

        /* TD(8): Colchete / Chave / Aspas ([ { ' ") */
        td8: tap_dance_8 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp LBKT>, <&kp LBRC>, <&kp SQT>, <&kp DQT>;
        };

        /* TD(9): Fechamento e Barras (] } \ |) */
        td9: tap_dance_9 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp RBKT>, <&kp RBRC>, <&kp BSLH>, <&kp PIPE>;
        };

        /* TD(10): Parênteses e Menor/Maior (( < ) >) */
        td10: tap_dance_10 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp LPAR>, <&kp LT>, <&kp RPAR>, <&kp GT>;
        };

        /* TD(30): Alternância Rápida de Camadas (Base, Símbolos, Numpad, Bluetooth) */
        td30: tap_dance_30 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&to 0>, <&to 1>, <&to 2>, <&to 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* -----------------------------------------------------------------------------------------
         * CAMADA 0: BASE (QWERTY)
         * ----------------------------------------------------------------------------------------- */
        default_layer {
            bindings = <
&gresc     &kp Q   &kp W   &kp E     &kp R    &kp T        &kp AT   &kp Y   &kp U      &kp I     &kp O    &kp P
&kp CLCK   &kp A   &kp S   &kp D     &kp F    &kp G        &td0     &kp H   &kp J      &kp K     &kp L    &kp SEMI
&kp LSHFT  &kp Z   &kp X   &kp C     &kp V    &kp B        &none    &kp N   &kp M      &kp COMMA &kp DOT  &kp FSLH
                           &kp LALT  &kp TAB  &kp SPACE    &kp RET  &td30   &kp BSPC
            >;
        };

        /* -----------------------------------------------------------------------------------------
         * CAMADA 1: SÍMBOLOS, NAVEGAÇÃO & MÍDIA
         * ----------------------------------------------------------------------------------------- */
        symbols_layer {
            bindings = <
&kp F1     &kp F2     &kp F3        &kp F4        &kp F5     &kp F6       &kp PG_UP  &kp F7     &kp F8     &kp F9      &kp F10    &kp F11
&kp EXCL   &kp AT     &kp HASH      &kp DLLR      &kp PRCNT  &kp CARET    &kp PG_DN  &kp PSCRN  &none      &kp C_CALC  &kp C_PP   &kp C_MUTE
&kp AMPS   &kp ASTRK  &kp UNDER     &kp PLUS      &kp EQUAL  &kp MINUS    &kp DEL    &none      &kp C_PREV &kp C_STOP  &kp C_NEXT &kp F12
                                    &kp HOME      &kp END    &kp LGUI     &kp RET    &td30      &kp C_VOL_DN
            >;
        };

        /* -----------------------------------------------------------------------------------------
         * CAMADA 2: NUMPAD & NAVEGAÇÃO
         * ----------------------------------------------------------------------------------------- */
        numpad_layer {
            bindings = <
&none      &none      &kp UP        &none         &none      &kp F2       &kp EQUAL  &kp DOT    &kp N7     &kp N8      &kp N9     &kp LC(LS(V))
&none      &kp LEFT   &kp DOWN      &kp RIGHT     &kp LC(C)  &kp UP       &gresc     &kp RC(FSLH) &kp N4   &kp N5      &kp N6     &td1
&none      &none      &none         &none         &kp LEFT   &kp DOWN     &none      &kp N0     &kp N1     &kp N2      &kp N3     &td0
                                    &kp LC(V)     &td9       &kp LCTRL    &kp RET    &td30      &kp BSPC
            >;
        };

        /* -----------------------------------------------------------------------------------------
         * CAMADA 3: SISTEMA & BLUETOOTH (ZMK EXCLUSIVE)
         * ----------------------------------------------------------------------------------------- */
        adjust_layer {
            bindings = <
&bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4    &none  &none  &none  &none  &none  &sys_reset
&bootloader  &none        &none        &none        &none        &none           &none  &none  &none  &none  &none  &bootloader
&none        &none        &none        &none        &none        &none           &none  &none  &none  &none  &none  &none
                                       &none        &none        &to 0           &to 0  &none  &none
            >;
        };
    };
};
